{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"resolveJsonModule": true,

		"noEmit": true,

		"strict": true,

		"strictNullChecks": true,
		"noUnusedLocals": false, // I set eslint to complain softly instead
		"noImplicitReturns": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		"importHelpers": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,

		"sourceMap": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noUncheckedIndexedAccess": false
	},
	"vueCompilerOptions": {
		"strictTemplates": true,
		"fallthroughAttributes": true,
		"checkUnknownComponents" : false, // is causing issues with fallthroughComponentNames
		"fallthroughComponentNames": ["Transition", "KeepAlive", "Teleport", "Suspense"],
		"dataAttributes": ["data-*"]
	}
}
